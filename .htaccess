<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # If the request is for an actual file or directory, serve it normally
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l

  # Otherwise, always serve index.html (your React app)
  RewriteRule . /index.html [L]
</IfModule>
